---
import { cms } from "@shared/cms/sheltify-access"

const config = await cms.tenantConfig;
---

<div data-pagefind-ignore class="snhg-footer article">
  <div class="sui wrapper flex-y gap-4 ai-center py-4">
    <a href="https://www.gesetze-im-internet.de/tierschg/__11.html" target="_blank" rel="noopener" class="p11-link">
      Zertifiziert nach §11 Tierschutzgesetz
    </a>
    <div class="sui flex-x jc-center wrap gap-4">
      <img class="logo" alt="snhg-logo" src="/logo-footer.png">
      <div>
        <h2>Kontakt</h2>
        {config.Name}
        <br>
        <br>
        <b>Vorsitz</b>
        <br>
        {(config.Chairmanship??"").split('\n').map(line => (
          <>{line}<br/></>
        ))}
        <br><br>
        <b>Vereinssitz</b>
        <br>
        {(config.Address??"").split('\n').map(line => (
          <>{line}<br/></>
        ))}
        <br>
        <b>Kontakt</b>
        <br>
        {config.Email}
      </div>
      <div>
        <h2>Spendenkonto</h2>
        {(config.IBAN??"").split('\n').map(line => (
          <>{line}<br/></>
        ))}

        {config.LinkPaypal &&
          <div>
            <br>
            <span>...Oder bequem per PayPal</span>
            <br>
            <a href={config.LinkPaypal} target="_blank"><button class="paypal">PayPal</button></a>
          </div>
        }

      </div>
      <div>
        <h2>Soziale Netzwerke</h2>
      </div>
    </div>
  </div>
</div>


<style lang="scss">
  .snhg-footer {
    background: var(--c-accent);
    color: #454545;

    h2 {
      font-family: Poppins, system-ui;
      font-size: 24px;
      font-weight: normal;
    }

    .logo {
      height: 180px;
      width: 180px;
      object-fit: contain;
    }

    .p11-link {
      background: #8a8a8a;
      padding: 6px 16px;
      border-radius: 32px;
      color: #fff;
      font-size: 1rem;
      font-weight: 600;
    }
  }
</style>
