---
import { cms } from "@shared/cms/sheltify-access";
import HeaderEntryMobile from '@shared/components/HeaderEntryMobile.astro';
import SearchBar from "@shared/components/SearchBar.astro";
import SearchPanel from "@shared/components/SearchPanel.astro";
import CmsImg from "@shared/components/ui/CmsImg.astro";
import { createPageStructure } from "sheltify-lib/page-structure.ts";
import HeaderEntry from "./HeaderEntry.astro";

const pages = (await cms.getPages())
  .filter((page) => page.PublishedAt?.Valid && page.ArticleID && page.ShowInMenu)
  .sort((a, b) => b.Priority - a.Priority);

const menu = [...createPageStructure(pages).values()];
const startPage = menu.find((item) => item.link == "/");
const tenantConfig = await cms.tenantConfig;
const logo = tenantConfig.LogoHeader;
const logoMobile = tenantConfig.LogoSmall ?? logo;
---

<nav class="themable header desktop">
  <div class="logo">
    <a href={startPage && "/"}>
      {logo && <CmsImg img={logo} size="medium" refetch={false} />}
    </a>
  </div>
  <div class="menu">
    {menu.map((item) => <HeaderEntry entry={item} startPageName="Home" />)}
  </div>
  <SearchBar isMobile={false}/>
</nav>

<nav class="themable header mobile" aria-label="Hauptmenü">
  <div class="mobile-topbar">
    <a class="logo" href={startPage && "/"}>
      {logoMobile && <CmsImg img={logoMobile} size="medium" refetch={false} />}
    </a>
    <div class="mobile-actions">
      <SearchBar isMobile={true} />
      <button class="burger" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="menu" id="mobile-menu">
    {menu.map((item) => <HeaderEntryMobile entry={item} startPageName="Home" />)}
  </div>
</nav>
<SearchPanel/>

<style is:global lang="scss">
  nav.desktop {
    display: flex;
    align-items: center;
    height: var(--header-height);
    top: 0;
    transition: opacity 0.3s;
    position: fixed;
    z-index: 22;
    width: 100dvw;
    box-shadow: 0 0 22px rgba(0, 0, 0, 0.22);
    padding: 0 16px;
    gap: 24px;
    background-color: #fff;
    font-size: 1.25rem;
    font-weight: 600;

    &.header-hidden {
      opacity: 0;
      pointer-events: none;
    }

    .logo {
      padding-left: 42px;
      height: 100%;
    }

    .logo img {
      height: 90%;
    }

    .menu {
      flex-grow: 1;
      display: flex;
      align-items: center;
      justify-content: space-evenly;
      height: 100%;
    }
  }

  @keyframes mobile-menu-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }

  nav.mobile {
    display: none;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 22;
    width: 100%;
    box-shadow: 0 0 22px rgba(0, 0, 0, 0.22);
    background-color: #fff;
    font-size: 1.1rem;

    .mobile-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      height: var(--header-height);
      padding: 0 8px 0 16px;
      box-sizing: border-box;
    }

    .logo {
      display: flex;
      align-items: center;
      min-width: 0;
      height: 100%;
      padding: 8px 0;
      box-sizing: border-box;

      img {
        display: block;
        height: 100%;
        width: auto;
        max-width: 100%;
        object-fit: contain;
        object-position: left center;
      }
    }

    .mobile-actions {
      display: flex;
      align-items: center;
      gap: 4px;
      flex-shrink: 0;
    }

    // three bars that turn into an X when the menu is open
    .burger {
      position: relative;
      width: 44px;
      height: 44px;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 50%;
      background: none;
      color: inherit;
      cursor: pointer;

      span {
        position: absolute;
        left: 11px;
        width: 22px;
        height: 2px;
        border-radius: 2px;
        background: currentColor;
        transition: transform 0.2s, opacity 0.2s;

        &:nth-child(1) { top: 15px; }
        &:nth-child(2) { top: 21px; }
        &:nth-child(3) { top: 27px; }
      }
    }

    &.open .burger span {
      &:nth-child(1) { transform: translateY(6px) rotate(45deg); }
      &:nth-child(2) { opacity: 0; }
      &:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
    }
  }

  // higher specificity than site themes (e.g. `nav.themable.header .menu { justify-content: center }`)
  nav.themable.header.mobile .menu {
    display: none;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px 0 16px;
    border-top: 1px solid #0000000f;
  }

  nav.themable.header.mobile.open .menu {
    display: flex;
    animation: mobile-menu-in 0.18s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    nav.themable.header.mobile.open .menu {
      animation: none;
    }
  }

  @media (max-width: 1000px) {
    nav.mobile {
      display: flex;
    }
    nav.desktop {
      display: none;
    }
  }


</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>(".header a")!;
  const burger = document.querySelector<HTMLElement>(".burger")!;
  const mobileNav = document.querySelector<HTMLElement>("nav.mobile")!;

  // Highlight the active link
  for (const link of links) {
    if (link.href === window.location.href) {
      link.classList.add("active");
    }
  }

  function setMobileMenuOpen(open: boolean) {
    mobileNav.classList.toggle("open", open);
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
    // the page behind the open menu should not scroll
    document.documentElement.style.overflow = open ? "hidden" : "";
  }

  burger.addEventListener("click", () => {
    setMobileMenuOpen(!mobileNav.classList.contains("open"));
  });

  // opening the search closes the menu
  mobileNav.querySelector(".search-toggle")?.addEventListener("click", () => setMobileMenuOpen(false));

  document.addEventListener("click", (e) => {
    if (!mobileNav.classList.contains("open") || mobileNav.contains(e.target as HTMLElement)) return;
    setMobileMenuOpen(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && mobileNav.classList.contains("open")) setMobileMenuOpen(false);
  });

  // switching to the desktop layout with the menu open must not leave the page scroll-locked
  window.matchMedia("(min-width: 1001px)").addEventListener("change", (e) => {
    if (e.matches) setMobileMenuOpen(false);
  });

  // submenus open like an accordion
  mobileNav.querySelectorAll<HTMLElement>(".mobile-group").forEach((group) => {
    const toggle = group.querySelector<HTMLButtonElement>(".mobile-group-toggle");
    toggle?.addEventListener("click", () => {
      const open = group.classList.toggle("open");
      toggle.setAttribute("aria-expanded", String(open));
    });
  });


  // hide / show header when scrolling down / up
  let previousScroll = window.scrollY || document.documentElement.scrollTop;
  let currentScroll;
  let direction = 0;
  let prevDirection = 0;
  const header = document.querySelector('.header')!;

  function checkScroll() {
    currentScroll = window.scrollY || document.documentElement.scrollTop;
    if (currentScroll > previousScroll) {
      direction = 2;
    } else if (currentScroll < previousScroll) {
      direction = 1;
    }

    if (direction !== prevDirection) {
      toggleHeader(direction, currentScroll);
    }

    previousScroll = currentScroll;
  }

  function toggleHeader(direction: number, curScroll: number) {
    if (direction === 2 && curScroll > 52 && screen.width > 766) {
      header.classList.add('header-hidden');
      prevDirection = direction;
    } else if (direction === 1) {
      header.classList.remove('header-hidden');
      prevDirection = direction;
    }
  };

  window.addEventListener('scroll', checkScroll);
</script>
