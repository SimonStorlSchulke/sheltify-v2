---
interface Props {
  isMobile: boolean,
}

const { isMobile } = Astro.props;
---

<button
  class:list={['search-toggle', { 'search-toggle-mobile': isMobile }]}
  type="button"
  aria-label="Suche öffnen"
  aria-expanded="false"
>
  <span style="filter: saturate(0) contrast(2)">🔍</span>
  {isMobile && <span>Suchen</span>}
</button>

<style is:global>
    .search-toggle {
        width: 64px;
        margin-right: 8px;
        cursor: pointer;
    }

    .search-toggle-mobile {
        width: auto;
        display: flex;
        gap: 8px;
        align-items: center;
    }
</style>
