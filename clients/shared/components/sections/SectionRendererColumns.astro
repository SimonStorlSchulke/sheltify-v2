---
import type { SectionColumns } from 'sheltify-lib/article-types.ts';
import type { CmsAnimal, CmsTenantConfiguration } from 'sheltify-lib/cms-types.ts';
import RenderSectionTitle from 'article-renderer/components/RenderSectionTitle.svelte';
import RenderSectionText from 'article-renderer/components/RenderSectionText.svelte';
import RenderSectionAnimalList from 'article-renderer/components/RenderSectionAnimalList.svelte';
import RenderSectionImages from 'article-renderer/components/RenderSectionImages.svelte';
import RenderSectionAnimalUpdates from 'article-renderer/components/RenderSectionAnimalUpdates.svelte';
import RenderSectionFile from 'article-renderer/components/RenderSectionFile.svelte';
import RenderSectionHero from 'article-renderer/components/RenderSectionHero.svelte';
import RenderSectionVideo from 'article-renderer/components/RenderSectionVideo.svelte';
import RenderSectionTeamMember from 'article-renderer/components/RenderSectionTeamMember.svelte';

interface Props {
  section: SectionColumns,
  allAnimalsByArticle?: Record<string, CmsAnimal[]>,
  tenantConfig?: CmsTenantConfiguration,
}

const {section, allAnimalsByArticle, tenantConfig} = Astro.props;
---
<div class="column-row sui flex-x">
{
  section.Content.Columns.map(column => {

    const sections = column.Sections.map(section => {
      let comp;
      switch (section.SectionType) {
        case 'text':
          comp = <RenderSectionText section={section} allAnimalsByArticle={allAnimalsByArticle} tenantConfig={tenantConfig}/>;
          break;
        case 'title':
          comp = <RenderSectionTitle section={section}/>
          break;
        case 'separator-x':
          comp = <hr/>;
          break;
        case 'hero':
          comp = <RenderSectionHero section={section} client:visible/>;
          break;
        case 'video':
          comp = <RenderSectionVideo section={section} client:visible/>;
          break;
        case 'animal-list':
          comp = <RenderSectionAnimalList section={section} allAnimalsByArticle={allAnimalsByArticle}/>;
          break;
        case 'image':
          comp = <RenderSectionImages section={section} client:load/>;
          break;
        case 'file':
          comp = <RenderSectionFile section={section} client:load/>;
          break;
        case 'animal-updates':
          comp = <RenderSectionAnimalUpdates section={section} allAnimalsByArticle={allAnimalsByArticle}/>;
          break;
        case 'team-member':
          comp = <RenderSectionTeamMember section={section}/>;
          break;
        default:
          comp = <div>Sektionstyp nicht unterstützt</div>;
          break;
        }

      // text is rendered without a wrapping element, so a flex container would put its paragraphs side by side
      const layoutClasses = section.SectionType == 'text' ? '' : ' flex-x wrap';
      return <div class={`section-${section.SectionType} sui${layoutClasses}`}>{comp}</div>;
      })
    return <div style={`flex: ${column.Grow} 1 0px`}  class="column">{sections}</div>
    })
}
</div>

<style lang="scss">
  .column-row {
    flex: 0 0 20px;
    gap: var(--section-gap-x);
    min-width: 300px;
    flex-wrap: wrap;
  }

  .column {
    gap: var(--section-gap-y);
    // Spalten umbrechen, sobald sie schmaler als 280px würden (mobil untereinander)
    min-width: min(280px, 100%);
    max-width: 100%;
  }
</style>